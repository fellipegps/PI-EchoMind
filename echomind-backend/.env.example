# -- Supabase (banco de dados) ----------------------------------------------
# Encontre em: Supabase Dashboard -> Project Settings -> Database -> URI
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJECT_REF].supabase.co:5432/postgres

# -- Autenticacao JWT --------------------------------------------------------
JWT_SECRET=gere_com_python_-c_import_secrets_print_secrets_token_hex_32
JWT_EXPIRE_HOURS=8

# -- Admin padrao (criado pelo seed.py) -------------------------------------
SEED_ADMIN_EMAIL=admin@echomind.com
SEED_ADMIN_PASSWORD=EchoMind@2025

# -- Groq (LLM) --------------------------------------------------------------
# Chave gratuita em: console.groq.com
GROQ_API_KEY=gsk_SUBSTITUA_PELA_SUA_CHAVE
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# -- Embeddings locais -------------------------------------------------------
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# -- RAG ---------------------------------------------------------------------
SIMILARITY_THRESHOLD=0.45
TOP_K_DOCS=3
