# -- Supabase (banco de dados) ----------------------------------------------
# Encontre em: Supabase Dashboard -> Project Settings -> Database -> URI
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJECT_REF].supabase.co:5432/postgres

# -- Supabase Auth ----------------------------------------------------------
SUPABASE_URL=https://[SEU_PROJECT_REF].supabase.co
SUPABASE_SECRET_KEY=sb_secret_...  # Project Settings > API Keys > Secret key (nunca expor no frontend)

# -- CORS -------------------------------------------------------------------
# Origens exatas do frontend, separadas por virgula. Nao use wildcard, paths ou secrets.
# Em staging/producao, substitua somente pelos dominios definidos para cada ambiente.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -- Groq (LLM) --------------------------------------------------------------
# Chave gratuita em: console.groq.com
GROQ_API_KEY=gsk_SUBSTITUA_PELA_SUA_CHAVE
GROQ_LLM_MODEL=openai/gpt-oss-120b

# -- Embeddings locais -------------------------------------------------------
EMBED_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# -- RAG ---------------------------------------------------------------------
# Calibrado sobre o dataset sintético versionado da PR 22/23; continua configurável.
SIMILARITY_THRESHOLD=0.35
TOP_K_DOCS=3

# -- Reranker local (opcional) -------------------------------------------------
# Desativado por padrão: o primeiro uso baixa o modelo ONNX para HF_HOME.
# BAAI/bge-reranker-base: licença MIT, aproximadamente 1,04 GB no FastEmbed.
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base
# O limite é normalizado para a faixa de 10 a 15 candidatos híbridos.
RERANKER_CANDIDATE_LIMIT=12
RERANKER_MAX_CHARS=2000
RERANKER_TIMEOUT_SECONDS=1.5

# -- Upload documental --------------------------------------------------------
# Limite em MiB para os bytes originais de PDF, TXT e DOCX.
MAX_DOCUMENT_SIZE_MB=10
