# Public build configuration for Vercel Production. Fill privately in its dashboard.
# NEXT_PUBLIC_* values are included in the browser bundle.
NEXT_PUBLIC_API_URL=https://CHANGE_ME.example.com
NEXT_PUBLIC_SUPABASE_URL=https://CHANGE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CHANGE_ME
# Enable when publishing the complete application with its AWS API.
ECHOMIND_REQUIRE_API_URL=true
