# Production runtime file. Copy OUTSIDE the checkout and fill it privately.
# Raw Compose syntax: one NAME=value per line, no quotes or inline comments.
# Never put actual values in this versioned example.
ECHOMIND_ENV=production
DATABASE_URL=CHANGE_ME
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_SECRET_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME
ALLOWED_ORIGINS=https://CHANGE_ME.vercel.app
GROQ_LLM_MODEL=openai/gpt-oss-120b
EMBED_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
RERANKER_ENABLED=false
RAG_WARMUP_ENABLED=true
RAG_WARMUP_TIMEOUT_SECONDS=30
DOCUMENT_RECOVERY_ENABLED=true
MAX_DOCUMENT_SIZE_MB=10
TOP_K_DOCS=3
SIMILARITY_THRESHOLD=0.45
UNCERTAIN_DISTANCE_THRESHOLD=0.38
HF_HOME=/var/cache/echomind/models
DOCUMENT_STORAGE_DIR=/var/lib/echomind/documents
RATE_LIMIT_INSTANCE_COUNT=1
UVICORN_WORKERS=1
WEB_CONCURRENCY=1
RATE_LIMIT_MAX_BUCKETS=10000
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_REQUESTS=5
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
