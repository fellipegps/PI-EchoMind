# Public deployment settings, separate from the private backend env_file.
# Fill API_DOMAIN and ACME_EMAIL before the first public startup.
BACKEND_IMAGE=echomind-backend:CHANGE_ME
BACKEND_ENV_FILE=/etc/echomind/backend.env
PROXY_IMAGE=echomind-proxy:CHANGE_ME
API_DOMAIN=api.CHANGE_ME.com
ACME_EMAIL=CHANGE_ME@example.com
PROXY_BIND_IP=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
# Keep the proxy IP inside this subnet; avoid the VPC and other Docker networks.
PROXY_SUBNET=172.30.80.0/29
PROXY_IP=172.30.80.2
BACKEND_PRIVATE_IP=172.30.80.3
