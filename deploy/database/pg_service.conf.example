# Private client config example. Copy outside the checkout as pg_service.conf.
# Get the actual session-pooler host and username from Supabase > Connect.
# This file contains no password. Use a separate private PGPASSFILE (mode 600).
[echomind]
host=CHANGE_ME.pooler.supabase.com
port=5432
dbname=postgres
user=postgres.CHANGE_ME
sslmode=require
connect_timeout=10
application_name=echomind-maintenance
