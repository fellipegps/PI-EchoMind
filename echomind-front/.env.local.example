NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://[SEU_PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Provedor de imagens do mapa. Configure um serviço com capacidade adequada ao uso da instituição.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"

# Opcional: imagens aéreas para o cadastro administrativo. Informe URL e créditos
# exigidos pelo provedor escolhido; se faltar um deles, o mapa comum permanece.
# NEXT_PUBLIC_MAP_SATELLITE_TILE_URL=https://seu-provedor/{z}/{x}/{y}.jpg?key=SUA_CHAVE
# NEXT_PUBLIC_MAP_SATELLITE_TILE_ATTRIBUTION="&copy; Seu provedor de imagens"
